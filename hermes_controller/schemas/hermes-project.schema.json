{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes project manifest",
  "type": "object",
  "required": [
    "project_id", "repository", "ref", "platform", "working_directory",
    "runtime_directory", "allowed_engines", "default_engine", "capabilities"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "repository": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "platform": {"enum": ["linux", "windows"]},
    "worker_id": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "runtime_directory": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workspaces": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,64}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "allowed_engines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["codex", "claude", "hybrid", "native"]}
    },
    "default_engine": {"enum": ["auto", "codex", "claude", "hybrid", "native"]},
    "engine_policy": {"enum": ["balanced-v1"]},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task_type": {"type": "string", "minLength": 1},
    "execution_profile": {"type": "string", "minLength": 1},
    "human_gates": {"type": "array", "items": {"type": "string"}},
    "idempotency_policy": {"enum": ["safe_retry", "manual_reconcile"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
    "max_turns": {"type": "integer", "minimum": 1, "maximum": 50}
  },
  "additionalProperties": false
}
