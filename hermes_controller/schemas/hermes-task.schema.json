{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Controller task snapshot",
  "type": "object",
  "required": ["brain", "project", "repository", "ref", "task_type", "platform", "required_capabilities", "execution_profile", "human_gates", "idempotency_policy"],
  "properties": {
    "job_id": {"type": "string"},
    "brain": {
      "type": "object",
      "required": ["repository", "ref", "commit"],
      "properties": {
        "repository": {"type": "string"},
        "ref": {"type": "string"},
        "commit": {"type": "string"},
        "task_file": {"type": "string"}
      },
      "additionalProperties": true
    },
    "task_text": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "project": {"type": "string"},
    "repository": {"type": "string"},
    "ref": {"type": "string"},
    "task_type": {"type": "string"},
    "platform": {"enum": ["linux", "windows"]},
    "worker_id": {"type": "string"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "execution_profile": {"type": "string"},
    "execution_engine": {"enum": ["codex", "claude", "hybrid", "native", "brainstorm"]},
    "engine_selection": {
      "type": "object",
      "required": ["mode", "selected_engine"],
      "properties": {
        "mode": {"enum": ["auto", "explicit", "project-default"]},
        "policy": {"type": "string"},
        "rule": {"type": "string"},
        "selected_engine": {"enum": ["codex", "claude", "hybrid", "native", "brainstorm"]}
      },
      "additionalProperties": false
    },
    "brainstorm": {
      "type": "object",
      "required": ["version", "candidate_count", "rubric_id", "rubric"],
      "properties": {
        "version": {"const": "brainstorm-v1"},
        "candidate_count": {"type": "integer", "minimum": 2, "maximum": 6},
        "rubric_id": {"enum": ["general-v1", "custom"]},
        "rubric": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "weight"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
              "label": {"type": "string", "minLength": 1, "maxLength": 80},
              "description": {"type": "string", "minLength": 1, "maxLength": 500},
              "weight": {"type": "integer", "minimum": 1, "maximum": 100}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "human_gates": {"type": "array", "items": {"enum": ["WINDOWS_FINAL_RENDER_REQUIRED", "YOUTUBE_PUBLICATION_APPROVAL", "LICENSE_REVIEW_REQUIRED", "VISUAL_ASSET_HANDOFF_REQUIRED", "PENTEST_ACTIVE_SCAN_APPROVAL_REQUIRED", "SOCIAL_PUBLICATION_APPROVAL_REQUIRED", "INFRASTRUCTURE_APPLY_APPROVAL_REQUIRED"]}},
    "idempotency_policy": {"enum": ["safe_retry", "manual_reconcile"]},
    "depends_on": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "working_directory": {"type": "string"},
    "run_output_dir": {"type": "string"},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "selected_workspaces": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
    "max_turns": {"type": "integer", "minimum": 1, "maximum": 50},
    "project_manifest_version": {"type": "integer", "minimum": 1}
  },
  "anyOf": [
    {"required": ["task_text"]},
    {"properties": {"brain": {"required": ["task_file"]}}}
  ],
  "additionalProperties": true
}
